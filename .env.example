# AXPORT 환경설정 예시 (2026-09-30 조원 배포용)
# 1) 이 파일을 복사해 프로젝트 최상위에 .env 로 저장한다:  Copy-Item .env.example .env
# 2) 본인이 발급받은 값만 채운다. 비워 둔 항목은 해당 기능만 꺼지거나 예시 값으로 동작한다.
# 3) .env 는 .gitignore 에 들어 있다. 절대 커밋·공유(카톡·메일·압축 파일)하지 않는다.
# 자세한 순서: TEAM_SETUP.md

# ───────── 1. 로그인(필수: /app 작업공간을 쓰려면) ─────────
# Supabase 프로젝트 > Project Settings > API. secret/service_role 키는 넣지 않는다(코드가 거부).
# 설정 방법: junhee/docs/ACCOUNTS_SETUP.md
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 32자 이상 무작위 문자열. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
# 로컬(http://127.0.0.1)에서는 false, Render(https)에서는 비워 두면 true
SESSION_COOKIE_SECURE=false
# 선택: 인증 메일 링크·챗봇 허용 주소의 기준 주소(예: https://<서비스 이름>.onrender.com). 비우면 접속한 주소를 쓴다
AXPORT_PUBLIC_URL=

# ───────── 2. 챗봇(선택) ─────────
# demo = 예시 답변(키 불필요) / live = OpenAI 호출(본인 키 필요, 사용량만큼 본인 계정에 과금)
AXPORT_CHAT_MODE=demo
# https://platform.openai.com/api-keys 에서 발급. live 일 때 두 값이 모두 있어야 한다
OPENAI_API_KEY=
# 예: gpt-4.1-mini
OPENAI_MODEL=

# ───────── 3. 기업 파일 분석 엔진 외부 자료(선택) ─────────
# 없으면 해당 지표만 '검색 불가'로 표시하고 분석은 계속한다.
# UN Comtrade: https://comtradedeveloper.un.org
UN_COMTRADE_API_KEY=
# 공공데이터포털(관세청 등) 서비스키: https://www.data.go.kr  (위젯 수출기상도 CUSTOMS_API_KEY 와 같은 키를 써도 된다)
KCS_TRADE_API_KEY=
# 한국은행 ECOS: https://ecos.bok.or.kr/api
ECOS_API_KEY=
# 국가법령정보 공동활용: https://open.law.go.kr
LAW_API_KEY=

# ───────── 4. 바탕화면 위젯(선택) ─────────
# demo = 예시 값 / live = 아래 키로 실시간 조회
AXPORT_DATA_MODE=demo
# https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=
# https://www.thenewsapi.com
THENEWS_API_KEY=
# 공공데이터포털 관세청 서비스키(KCS_TRADE_API_KEY 와 같은 값 가능)
CUSTOMS_API_KEY=
# make_weather_json.py 로 만든 수출 통계 JSON 의 절대 경로(본인 PC 경로)
AXPORT_WEATHER_JSON=
# 선택: 한국수출입은행 환율(위젯 환율 예비 경로): https://www.koreaexim.go.kr
KOREAEXIM_API_KEY=
# 위젯 공식 자료(환율·뉴스·수출기상도) 자동 갱신: Render 에서는 기본 켜짐, 로컬은 1 로 켠다(0 은 끔)
AXPORT_WIDGET_REFRESH=

# ───────── 5. 기타(선택) ─────────
# 키를 .env 대신 별도 텍스트 파일로 관리하고 싶을 때만 그 파일의 절대 경로를 적는다(junhee/scripts 에서 사용)
AXPORT_KEY_FILE=
